{
  "name": "hp-check-me",
  "productName": "HP Check Me",
  "version": "1.0.2",
  "description": "Employee Management System (Khmer) - desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish=never"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.hpcheckme.app",
    "productName": "HP Check Me",
    "artifactName": "HPCheckMe-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "package.json",
      "*.html",
      "*.js",
      "*.css",
      "!.github/**/*",
      "!dist/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Imsprosopheak1995",
      "repo": "Payroll-System-Managerment-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
